# Copy to .env and adjust. Docker Compose loads .env automatically.
#
# .env is machine-specific and gitignored; this file is the committed template.

# order-mysql's host port. Change it if something already owns 3306 -- a Windows MySQL
# service will, and the resulting bind failure ("Only one usage of each socket address")
# does not obviously point at MySQL.
ORDER_DB_PORT=3306

# inventory-mysql's host port.
INVENTORY_DB_PORT=3307

# Kafka's HOST listener. Containers reach the broker at kafka:9092 over the compose network
# regardless; this is only for clients running on the host.
KAFKA_HOST_PORT=29092

MYSQL_ROOT_PASSWORD=root
